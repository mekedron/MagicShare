<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)magicshare.shared_group</string>
	</array>
	<!-- Firebase Auth on macOS persists anon credentials in the keychain;
	     under the sandbox this requires an explicit access group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.magicshare.app</string>
	</array>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- QR-pairing scanner uses mobile_scanner; under the macOS sandbox
	     Permission.camera.request() returns denied without this entitlement. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- com.apple.developer.aps-environment is intentionally NOT in the
	     Debug entitlements. Push Notifications is a restricted capability
	     that requires a paid Apple Developer team — Personal (free) teams
	     cannot synthesise an APNs provisioning profile, so including it
	     here breaks `flutter run -d macos` for any developer without a
	     paid account. APNs / FCM-push delivery is verified in Release
	     builds, not local Debug. Release.entitlements keeps it. -->
</dict>
</plist>
