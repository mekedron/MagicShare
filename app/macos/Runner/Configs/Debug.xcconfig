#include "../../Flutter/Flutter-Debug.xcconfig"
#include "Warnings.xcconfig"

// Code-signing settings for local Debug builds intentionally inherit
// from the project file (set via Xcode → Runner → Signing &
// Capabilities). FirebaseAuth on macOS persists the anon session in
// the keychain, which requires a real signing identity (Personal Team
// or Apple Developer Team) — the previous "skip signing" override
// here forced ad-hoc and broke FirebaseAuth.
//
// Each developer sets their own DEVELOPMENT_TEAM via Xcode's UI; that
// value lives in `Runner.xcodeproj/project.pbxproj` and is honoured by
// both `flutter run -d macos` and Xcode-driven builds.
