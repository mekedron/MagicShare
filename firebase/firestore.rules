rules_version = '2';

// Default-deny baseline for the MagicShare cloud-sync backend.
//
// Real per-collection rules land in Epic 2 ("Schema and security rules"),
// alongside `@firebase/rules-unit-testing` cases. Until then, all client
// reads and writes are rejected; only the Admin SDK (i.e. Cloud Functions)
// can mutate Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
