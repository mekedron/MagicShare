{
  "name": "@magicshare/functions",
  "private": true,
  "version": "0.0.1",
  "description": "MagicShare cloud-sync Cloud Functions (TypeScript, Node 20).",
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src test",
    "lint:fix": "eslint --ext .ts --fix src test",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase --project=demo-magicshare-rules emulators:exec --only firestore 'vitest run --config vitest.rules.config.ts'",
    "test:functions": "firebase --project=demo-magicshare-functions emulators:exec --only auth,firestore 'vitest run --config vitest.functions.config.ts'",
    "dev": "npm run build && firebase --project=magic-share-backend emulators:start --import=../.emulator-data --export-on-exit=../.emulator-data",
    "deploy": "firebase --project=magic-share-backend deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "firebase": "^12.12.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
