#!/usr/bin/env bash
# MagicShare pre-commit hook.
#
# Two stages, both scoped to staged Dart files in app/ and common/:
#   1. dart format — auto-formats and re-stages so commits never fail
#      CI's `dart format --set-exit-if-changed lib test` step.
#   2. flutter / dart analyze — runs on the staged file set so issues
#      like unused imports or type errors are caught locally before
#      hitting CI's `flutter analyze` (which fails the build on any
#      finding).
#
# Bypass envs:
#   SKIP_DART_FORMAT_HOOK=1   skip stage 1 only.
#   SKIP_DART_ANALYZE_HOOK=1  skip stage 2 only.
#   SKIP_DART_HOOKS=1         skip both.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

skip_all=${SKIP_DART_HOOKS:-0}
skip_format=${SKIP_DART_FORMAT_HOOK:-0}
skip_analyze=${SKIP_DART_ANALYZE_HOOK:-0}

if [ "$skip_all" = "1" ]; then
  exit 0
fi

# --- Collect staged Dart files in app/ and common/. ---
staged=()
while IFS= read -r line; do
  [ -n "$line" ] && staged+=("$line")
done < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | { grep -E '^(app|common)/.*\.dart$' || true; }
)

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

existing=()
for f in "${staged[@]}"; do
  [ -f "$f" ] && existing+=("$f")
done

if [ ${#existing[@]} -eq 0 ]; then
  exit 0
fi

require_dart() {
  if ! command -v dart >/dev/null 2>&1; then
    cat >&2 <<'EOF'
pre-commit: 'dart' is not on PATH.

Install the Dart/Flutter toolchain (e.g. `mise install` from the repo root)
or set SKIP_DART_HOOKS=1 to bypass this hook for one commit.
EOF
    exit 1
  fi
}

# --- Stage 1: format. ---
if [ "$skip_format" != "1" ]; then
  require_dart
  if ! dart format --set-exit-if-changed --output=write "${existing[@]}"; then
    git add -- "${existing[@]}"
    echo
    echo "pre-commit: dart format reformatted the files above and re-staged them."
  fi
fi

# --- Stage 2: analyze. Group staged files by package and run the right
# analyzer from each package's directory; flutter/dart analyze resolves
# pubspec relative to the working dir.
if [ "$skip_analyze" = "1" ]; then
  exit 0
fi

require_dart

app_files=()
common_files=()
for f in "${existing[@]}"; do
  case "$f" in
    app/*) app_files+=("${f#app/}") ;;
    common/*) common_files+=("${f#common/}") ;;
  esac
done

run_analyze() {
  local pkg_dir=$1
  shift
  local cmd=$1
  shift
  if [ "$#" -eq 0 ]; then
    return 0
  fi
  echo "pre-commit: $cmd analyze ${pkg_dir}/{${*}}"
  if ! (cd "$pkg_dir" && "$cmd" analyze --no-pub "$@"); then
    echo
    echo "pre-commit: $cmd analyze found issues. Fix them, or set"
    echo "  SKIP_DART_ANALYZE_HOOK=1 git commit ..."
    echo "to bypass for one commit."
    exit 1
  fi
}

if [ ${#app_files[@]} -gt 0 ]; then
  if ! command -v flutter >/dev/null 2>&1; then
    echo "pre-commit: 'flutter' is not on PATH; skipping app/ analyze." >&2
  else
    run_analyze app flutter "${app_files[@]}"
  fi
fi

if [ ${#common_files[@]} -gt 0 ]; then
  run_analyze common dart "${common_files[@]}"
fi
